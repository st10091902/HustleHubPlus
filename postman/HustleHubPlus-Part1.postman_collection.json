    {
      "name": "Registration",
      "item": [
        {
          "name": "Register Freelancer - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Registration was successful\", function () {\r",
                  "    pm.expect(response.success).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User information was returned\", function () {\r",
                  "    pm.expect(response.user).to.have.property(\"id\");\r",
                  "    pm.expect(response.user).to.have.property(\"email\");\r",
                  "    pm.expect(response.user).to.have.property(\"role\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Password is not exposed\", function () {\r",
                  "    pm.expect(response.user).to.not.have.property(\"password\");\r",
                  "    pm.expect(response.user).to.not.have.property(\"passwordHash\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Marco Marais\",\r\n  \"email\": \"marco@example.com\",\r\n  \"password\": \"HustleHub#2026\",\r\n  \"role\": \"FREELANCER\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
