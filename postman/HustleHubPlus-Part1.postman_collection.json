      "name": "Login",
      "item": [
        {
          "name": "Login - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Login was successful\", function () {\r",
                  "    pm.expect(response.success).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"JWT was returned\", function () {\r",
                  "    pm.expect(response.token).to.be.a(\"string\");\r",
                  "    pm.expect(response.token.length).to.be.above(20);\r",
                  "});\r",
                  "\r",
                  "if (response.token) {\r",
                  "    pm.collectionVariables.set(\"token\", response.token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
