# ==========================================
# HustleHub+ Git Ignore
# ==========================================

# Node dependencies
backend/node_modules/
node_modules/

# Environment variables / secrets
backend/.env
.env
.env.*

# Allow example environment configuration
!backend/.env.example
!.env.example

# Local SSL certificates and private keys
backend/certs/
certs/
*.key
*.pem
*.crt

# Logs
*.log
logs/

# Testing / coverage
coverage/

# IDE files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Frontend dependencies
frontend/node_modules/

# Frontend production build
frontend/dist/

# Frontend local environment
frontend/.env